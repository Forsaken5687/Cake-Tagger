# Local results, tokens, feedback and scratch files
/data/
/outputs/
/feedback/
/work/
/.agents/
/.codex/
/.kilo/
.env
.env.*
*.log
*.tmp
*.bak

# Large dependencies: restored by Cake-Tagger.exe or included in the sharing package
/model/*.onnx

# Media must never enter the repository
*.mp4
*.m4v
*.webm
*.mov
*.mkv
*.avi

# Editor and operating system files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*.download

# Python bytecode
__pycache__/
*.pyc

# Portable Python archives and assembled interpreter
/runtime/archives/
/runtime/cpython/
*.egg-info/
/build/
/dist/

# Generated Windows entry point
/Cake-Tagger.exe
