# Local results, tokens, feedback and scratch files
/data/
/outputs/
/feedback/
/work/
/.agents/
/.codex/
/.kilo/
.env
.env.*
*.log
*.tmp
*.bak

# Large dependencies: restored by Setup.ps1 or included in the sharing package
/model/*.onnx
/runtime/node.exe
/runtime/native/
node_modules/
/vendor/*.wasm

# Media must never enter the repository
*.mp4
*.m4v
*.webm
*.mov
*.mkv
*.avi

# Editor and operating system files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*.download
