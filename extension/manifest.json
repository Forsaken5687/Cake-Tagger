{
  "manifest_version": 3,
  "name": "Cake Tagger",
  "version": "0.6.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "cake-tagger@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "host_permissions": [
    "https://cake.ski/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "assets/logo.svg",
    "96": "assets/logo.svg"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "assets/logo.svg"
  },
  "background": {
    "scripts": [
      "extension/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://cake.ski/*"
      ],
      "js": [
        "extension/content.js"
      ],
      "css": [
        "extension/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "webext-api.js",
        "extension/local-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/upload-adapter.mjs",
        "extension/embedded-upload.mjs",
        "tags.txt",
        "extension/site-theme.mjs",
        "messages.mjs",
        "extension/bridge.html"
      ],
      "matches": [
        "https://cake.ski/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; img-src 'self' data: blob:; style-src 'self'; connect-src 'self' http://127.0.0.1:8765; frame-src http://127.0.0.1:8765; object-src 'none'"
  }
}
