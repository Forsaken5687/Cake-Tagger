{
  "manifest_version": 3,
  "name": "Cake Tagger",
  "version": "0.3.2",
  "description": "Lokale Tag-Vorschläge für Videos und Übernahme in cake.ski-Uploadfelder.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cake-tagger@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "host_permissions": ["https://cake.ski/*"],
  "permissions": ["storage"],
  "icons": { "48": "assets/logo.svg", "96": "assets/logo.svg" },
  "action": { "default_title": "Cake Tagger öffnen", "default_icon": "assets/logo.svg" },
  "background": { "scripts": ["extension/background.js"] },
  "content_scripts": [{ "matches": ["https://cake.ski/*"], "js": ["extension/content.js"], "css": ["extension/content.css"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["index.html", "extension/upload-adapter.mjs", "extension/embedded-upload.mjs", "tags.txt"], "matches": ["https://cake.ski/*"] }],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; connect-src 'self'; object-src 'none'"
  }
}
