{
  "manifest_version": 3,
  "name": "Cake Tagger",
  "version": "0.4.4",
  "description": "Local video tag suggestions and transfer to cake.ski upload fields.",
  "host_permissions": [
    "https://cake.ski/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "action": {
    "default_title": "Open Cake Tagger",
    "default_icon": {
      "16": "assets/logo-16.png",
      "32": "assets/logo-32.png"
    }
  },
  "background": {
    "service_worker": "extension/chrome-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cake.ski/*"
      ],
      "js": [
        "webext-api.js",
        "extension/content.js"
      ],
      "css": [
        "extension/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "extension/upload-adapter.mjs",
        "extension/embedded-upload.mjs",
        "tags.txt",
        "extension/site-theme.mjs",
        "messages.mjs"
      ],
      "matches": [
        "https://cake.ski/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; connect-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "120"
}
