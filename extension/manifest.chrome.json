{
  "manifest_version": 3,
  "name": "Cake Tagger",
  "version": "0.7.22",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "host_permissions": [
    "https://cake.ski/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "storage",
    "downloads"
  ],
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/logo-16.png",
      "32": "assets/logo-32.png"
    },
    "default_popup": "extension/popup.html"
  },
  "background": {
    "service_worker": "extension/chrome-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cake.ski/*"
      ],
      "js": [
        "extension/webext-api.js",
        "extension/content.js"
      ],
      "css": [
        "extension/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/upload-adapter.mjs",
        "extension/embedded-upload.mjs",
        "model/tags.txt",
        "src/shared/site-theme.mjs",
        "src/shared/messages.mjs",
        "extension/bridge.html",
        "extension/upload-ui.mjs",
        "src/shared/settings-ui.mjs",
        "src/shared/preferences.mjs",
        "src/shared/trusted-event.mjs"
      ],
      "matches": [
        "https://cake.ski/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; img-src 'self' data: blob:; style-src 'self'; connect-src 'self' http://127.0.0.1:8765; frame-src http://127.0.0.1:8765; object-src 'none'"
  },
  "minimum_chrome_version": "120"
}
